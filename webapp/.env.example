# Copy to .env and fill in real values. Never commit the actual .env file.

# Flask session signing key - any long random string. Required in production;
# falls back to an insecure dev default if unset.
SECRET_KEY=change-me-to-a-long-random-string

# Port the Flask dev server binds to.
PORT=5000

# PostgreSQL. DATABASE_URL, if set, takes priority over the individual vars.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=outreach
DATABASE_USER=outreach_app
DATABASE_PASSWORD=
DATABASE_SSLMODE=prefer

# Optional: seed an additional super admin account on startup (in addition
# to the auto-seeded local "demo" account). Only created if both are set
# and the username doesn't already exist.
SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Twilio - same account already used for SMS, Voice is a separate product
# under the same Account SID. Live credentials place real calls and cost
# money; test credentials are free but can only simulate calls (no audio
# actually reaches a phone) - useful for wiring/testing the integration
# before switching to live. Which pair is active is controlled by the
# "twilio_mode" setting (Settings page, or TWILIO_MODE below as the default).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TEST_ACCOUNT_SID=
TWILIO_TEST_AUTH_TOKEN=
# The Twilio phone number placing calls - MUST have Voice capability
# enabled in the Twilio Console (Phone Numbers -> the number -> Voice),
# not just SMS. Format: +1XXXXXXXXXX
TWILIO_FROM_NUMBER=

# "test" (default, safe - no real call, no cost) or "live" (places real
# calls). Overridable per-account from the Settings page at any time.
TWILIO_MODE=test

# Publicly reachable base URL for this server (e.g. an ngrok tunnel or your
# deployed domain), used for two things Twilio must reach over the internet:
#   1. Serving the generated Kokoro audio at {PUBLIC_BASE_URL}/api/audio/...
#      for <Play> during the call.
#   2. The call status webhook at {PUBLIC_BASE_URL}/api/webhooks/twilio/status.
# Leave unset for local development - calls still work, but fall back to
# Twilio's own <Say> (synthesized speech reading the script text) instead of
# the actual Kokoro audio, since Twilio cannot fetch a file from localhost.
PUBLIC_BASE_URL=
